# Private deployment values go into /etc/ai-stoica/mcp.env on the Hetzner server, NEVER in GitHub.
# Key from OmniRoute > API Manager, separate from the existing AI Stoica Web key.
OMNIROUTE_API_KEY=PASTE_NEW_UNSHARED_OMNIROUTE_MCP_KEY
# Distinct secret to be sent as an Authorization request header by Claude:
MCP_CLIENT_TOKEN=GENERATE_VIA_OPENSSL_RAND_HEX_32
# Empty allowed-models list means discover all models dynamically. Omit it entirely by default.
MCP_EXCLUDED_MODELS=
MCP_ALLOWED_ORIGINS=https://claude.ai,https://www.claude.ai
