POSTGRES_DB=aistoica
POSTGRES_USER=aistoica
# Orice caractere sunt permise, în afară de „$” (Docker Compose îl interpretează); exemplu: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_RANDOM
# E-mailul contului Owner (pune-l doar în fișierul .env de pe server, nu în GitHub).
OWNER_EMAIL=owner@exemplu.ro
# Recomandat: serverul creează singur contul Owner cu această parolă (minimum 8 caractere, ideal 16+ aleatoare),
# iar nimeni altcineva nu mai poate înregistra e-mailul Owner. Poți șterge variabila după prima pornire.
OWNER_INITIAL_PASSWORD=
SESSION_TTL_DAYS=30
PG_POOL_MAX=10
# Cereri pe minut per IP (fără /auth/me, care are limita lui).
RATE_LIMIT_PER_MINUTE=120
# Verificări de sesiune pe minut per IP (aplicația desktop verifică sesiunea la fiecare cerere).
AUTH_ME_PER_MINUTE=600
# Încercări greșite de autentificare permise per IP la 15 minute.
AUTH_ATTEMPTS_PER_15_MIN=20
# Conturi noi (cereri de acces) permise per IP pe oră.
REGISTRATIONS_PER_HOUR=10
# Câte proxy-uri stau în fața API-ului: 1 = Caddy; 2 = Cloudflare + Caddy.
TRUST_PROXY_HOPS=1
CORS_ORIGIN=*

# Complete this only when DNS points to the server.
AI_STOICA_DOMAIN=api.aistoica.ro

# --- Versiunea web și aplicația pentru telefon (PWA, gratuită, fără App Store / Google Play) ---
# Pentru serviciul „web” și HTTPS șterge „#” din fața liniei de mai jos (după ce DNS-ul indică spre server).
# COMPOSE_PROFILES=edge,web
# Adresa site-ului AI Stoica. DNS: o înregistrare A pentru aistoica.ro spre IP-ul serverului (aceeași ca api.aistoica.ro).
AI_STOICA_WEB_DOMAIN=aistoica.ro
# Modelul implicit (id exact; gol = prima combinație OmniRoute, de exemplu „Ai principal”).
AI_STOICA_DEFAULT_MODEL=
# Modelul ales în site răspunde el; true = dacă nu răspunde, trec la API-urile directe (Groq, Gemini…).
AI_STOICA_CHAT_FALLBACK=false
# Opțional: modele fixe pentru Poză / Video, de exemplu codex/gpt-5.6-sol (imagini prin abonamentul ChatGPT din OmniRoute).
AI_STOICA_IMAGE_MODEL=
AI_STOICA_VIDEO_MODEL=
# Cine face pozele și video-urile: gemini = doar Gemini (Nano Banana pentru poze, Veo pentru video, cu GEMINI_API_KEY
# sau Gemini conectat în OmniRoute). Mai mulți, cu virgulă (gemini,openai,xai); gol = toți furnizorii, și cei gratuiți.
AI_STOICA_IMAGE_PROVIDERS=gemini
AI_STOICA_VIDEO_PROVIDERS=gemini
# Nivelul gratuit pe cont și pe zi (Owner-ul e nelimitat): poze, videoclipuri scurte, fișiere PDF / Word / Excel / PowerPoint.
AI_STOICA_FREE_IMAGES=3
AI_STOICA_FREE_VIDEOS=1
AI_STOICA_FREE_DOCUMENTS=10
# Furnizori scoși din chat (cerebras implicit; gol = niciunul).
AI_STOICA_BLOCKED_PROVIDERS=cerebras
# Combinațiile OmniRoute pe care le pot folosi și celelalte conturi (numele, cu virgulă), de ex. Gratuit.
# Gol = doar Owner-ul: o combinație poate folosi abonamentele tale (Codex, Claude Code), care nu se împart.
AI_STOICA_SHARED_COMBOS=
# OmniRoute pornește împreună cu site-ul (profilul web), cu aceleași combinații ca pe Windows („Ai principal” etc.).
# Secret lung și aleator: openssl rand -hex 32.
OMNIROUTE_WS_BRIDGE_SECRET=
# Parola panoului OmniRoute la prima pornire (după importul bazei de pe PC devine parola de pe PC).
OMNIROUTE_INITIAL_PASSWORD=
# Obligatorie: OmniRoute refuză cererile fără cheie (401). Panou OmniRoute → API Manager → Create API Key
# (sau aceeași cheie ca pe PC, după importul bazei).
OMNIROUTE_API_KEY=
# Versiune fixă OmniRoute (recomandat), de exemplu 3.8.51.
OMNIROUTE_VERSION=latest
# Aceleași chei ca în aplicația Windows (Setări → API-uri AI), ca site-ul să aibă aceleași modele.
# Doar în .env de pe server, niciodată în GitHub. Gratuite: Cerebras, Groq, Gemini, Mistral, NVIDIA, GitHub Models, Cloudflare, Cohere, Hugging Face.
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
NVIDIA_API_KEY=
COHERE_API_KEY=
HF_TOKEN=
# GitHub Models (și GitHub Solve pentru Owner) folosesc un token GitHub.
AI_STOICA_GITHUB_TOKEN=
# Imagini și video (Pollinations merge și fără cheie; video are nevoie de una dintre ele)
POLLINATIONS_API_KEY=
FAL_API_KEY=
REPLICATE_API_TOKEN=
TOGETHER_API_KEY=
STABILITY_API_KEY=
# Grok (xAI), plătit pe consum: chat, poze și video Grok Imagine. Cheia: https://console.x.ai/
XAI_API_KEY=
