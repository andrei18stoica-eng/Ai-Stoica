{
  "name": "serasmart-desktop",
  "version": "0.7.26",
  "private": true,
  "description": "Serasmart AI 0.7.26 - a new interface: English by default with 24 languages, a dark premium theme with blue accents and an optional light one",
  "main": "main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrei18stoica-eng/Serasmart-AI.git"
  },
  "scripts": {
    "dev:ui": "vite --config vite.config.mjs",
    "dev": "vite build --config vite.config.mjs && electron .",
    "build:ui": "vite build --config vite.config.mjs",
    "build": "npm run build:ui && electron-builder --win --x64 --publish never",
    "release": "npm run build:ui && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "docx": "^9.8.0",
    "electron-updater": "^6.6.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mdb-reader": "^3.2.0",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "temml": "^0.13.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "ro.serasmart.ai",
    "productName": "Serasmart AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "local-gateway.cjs",
      "lib/**/*",
      "dist/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Serasmart_Setup_${version}_${arch}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "guid": "ebcb6e4a-55d6-520c-92fc-1817916ad533",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Serasmart AI"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "andrei18stoica-eng",
        "repo": "Serasmart-AI"
      }
    ]
  }
}
