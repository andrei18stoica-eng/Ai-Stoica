# Adresa publică HTTPS a backendului AI Stoica pentru telefon: Worker-ul Cloudflare (apps/cloudflare).
# Pentru build-urile EAS valoarea se pune în eas.json (build.<profil>.env) sau cu `eas env:create`.
EXPO_PUBLIC_GATEWAY_URL=https://ai-stoica.SUBDOMENIUL-TAU.workers.dev

# Numele motorului afișat în antetul aplicației.
EXPO_PUBLIC_DEFAULT_MODEL=AI Stoica Performance Max
