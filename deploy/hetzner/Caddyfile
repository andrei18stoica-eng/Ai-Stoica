{$SERASMART_DOMAIN} {
  encode zstd gzip
  reverse_proxy api:8787

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
  }
}

# Web version and installable phone app (PWA), served by the "web" service (profile "web").
# Until SERASMART_WEB_DOMAIN is set in .env this block only answers on web.localhost.
{$SERASMART_WEB_DOMAIN:web.localhost} {
  encode zstd gzip
  reverse_proxy web:8787

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    # SAMEORIGIN: the web interface shows Design previews from this same address in a frame.
    X-Frame-Options "SAMEORIGIN"
  }
}

# Claude MCP bridge, isolated from Serasmart AI Web.
# Enable DNS A record mcp.aistoica.ro -> Hetzner VPS before HTTPS activation.
mcp.aistoica.ro {
  encode zstd gzip
  reverse_proxy serasmart-mcp:3010
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
  }
}
