POSTGRES_DB=aistoica
POSTGRES_USER=aistoica
# Orice caractere sunt permise, în afară de „$” (Docker Compose îl interpretează); exemplu: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_RANDOM
# E-mailul contului Owner (pune-l doar în fișierul .env de pe server, nu în GitHub).
OWNER_EMAIL=owner@exemplu.ro
# Recomandat: serverul creează singur contul Owner cu această parolă (minimum 8 caractere, ideal 16+ aleatoare),
# iar nimeni altcineva nu mai poate înregistra e-mailul Owner. Poți șterge variabila după prima pornire.
OWNER_INITIAL_PASSWORD=
SESSION_TTL_DAYS=30
PG_POOL_MAX=10
# Cereri pe minut per IP (fără /auth/me, care are limita lui).
RATE_LIMIT_PER_MINUTE=120
# Verificări de sesiune pe minut per IP (aplicația desktop verifică sesiunea la fiecare cerere).
AUTH_ME_PER_MINUTE=600
# Încercări greșite de autentificare permise per IP la 15 minute.
AUTH_ATTEMPTS_PER_15_MIN=20
# Conturi noi (cereri de acces) permise per IP pe oră.
REGISTRATIONS_PER_HOUR=10
# Câte proxy-uri stau în fața API-ului: 1 = Caddy; 2 = Cloudflare + Caddy.
TRUST_PROXY_HOPS=1
CORS_ORIGIN=*

# Complete this only when DNS points to the server.
AI_STOICA_DOMAIN=api.aistoica.ro

# --- Versiunea web și aplicația pentru telefon (PWA, gratuită, fără App Store / Google Play) ---
# Pentru serviciul „web” și HTTPS șterge „#” din fața liniei de mai jos (după ce DNS-ul indică spre server).
# COMPOSE_PROFILES=edge,web
# Adresa site-ului AI Stoica. DNS: o înregistrare A pentru aistoica.ro spre IP-ul serverului (aceeași ca api.aistoica.ro).
AI_STOICA_WEB_DOMAIN=aistoica.ro
# Modelul implicit (id exact; gol = serviciul alege) și, opțional, OmniRoute.
AI_STOICA_DEFAULT_MODEL=
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
# Chei API pentru modele (doar în .env de pe server, niciodată în GitHub). Gratuite: Cerebras, Groq, Gemini, Cloudflare.
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
