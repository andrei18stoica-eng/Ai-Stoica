{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "serasmart",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "serasmart",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CF_MODEL": "@cf/nvidia/nemotron-3-120b-a12b",
    "CF_FALLBACK_MODEL": "@cf/openai/gpt-oss-120b",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "GEMINI_MODEL": "gemini-2.5-pro",
    "CEREBRAS_MODEL": "gpt-oss-120b",
    "SERASMART_MAX_HISTORY": "120",
    "SERASMART_MAX_CONTEXT_CHARS": "300000",
    "SERASMART_MAX_OUTPUT": "8192",
    "SERASMART_TEMPERATURE": "0.35",
    "GITHUB_REPO": "andrei18stoica-eng/Serasmart-AI",
    "GITHUB_BRANCH": "main",
    "SERASMART_FILE_MAX_MB": "25",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell"
  },
  "keep_vars": true,
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "serasmart-files-2026-001"
    }
  ]
}
