# Public HTTPS hostname that points to the server.
# Example after DNS is configured: ai.example.com
AI_STOICA_DOMAIN=ai.example.com

# E-mailul contului Owner pe acest server (GitHub Solve, rulare de cod, test server).
AI_STOICA_OWNER_EMAIL=

# OmniRoute stays private inside Docker.
OMNIROUTE_BASE_URL=http://omniroute:20128/v1
OMNIROUTE_API_KEY=
# Versiune fixă OmniRoute (recomandat), de exemplu 3.8.51; „latest” urmează automat ultima versiune stabilă.
OMNIROUTE_VERSION=latest

# Modelul folosit când aplicația nu trimite unul (un id exact din OmniRoute, de exemplu groq/openai/gpt-oss-120b).
# Gol = gateway-ul alege singur. Nu folosi „Ai principal”: selectarea automată este dezactivată.
AI_STOICA_DEFAULT_MODEL=
AI_STOICA_SPEECH_MODEL=openai/whisper-1
AI_STOICA_SPEECH_LANGUAGE=ro
# false = doar primul cont (al tău) se poate crea; true = oricine își poate face cont pe acest server.
AI_STOICA_OPEN_REGISTRATION=false

# Opțional: politica de conturi și permisiuni de pe serverul Hetzner (deploy/hetzner), de exemplu https://api.aistoica.ro
AI_STOICA_CLOUD_API_URL=
# Opțional: GitHub Solve pentru Owner.
AI_STOICA_GITHUB_TOKEN=
AI_STOICA_GITHUB_REPO=
AI_STOICA_GITHUB_BRANCH=main
# Câte proxy-uri stau în fața gateway-ului (1 = Caddy).
AI_STOICA_TRUST_PROXY=1

# Opțional: chei pentru API-urile directe, folosite când OmniRoute nu răspunde.
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Use a long random secret in production.
OMNIROUTE_WS_BRIDGE_SECRET=change-me-to-a-long-random-secret
