{
  "expo": {
    "name": "AI Stoica",
    "slug": "ai-stoica",
    "scheme": "aistoica",
    "version": "0.6.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "dark",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.stoica.aistoica",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ro.stoica.aistoica",
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#05070b"
      }
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ]
    ],
    "splash": {
      "image": "./splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070b"
    }
  }
}
