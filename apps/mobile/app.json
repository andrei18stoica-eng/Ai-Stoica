{
  "expo": {
    "name": "AI Stoica",
    "slug": "ai-stoica",
    "scheme": "aistoica",
    "version": "0.4.1",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.stoica.aistoica"
    },
    "android": {
      "package": "ro.stoica.aistoica",
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#05070b"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "splash": {
      "image": "./splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070b"
    }
  }
}
