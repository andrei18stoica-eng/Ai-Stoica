{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-stoica",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-stoica",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CF_MODEL": "@cf/nvidia/nemotron-3-120b-a12b",
    "CF_FALLBACK_MODEL": "@cf/openai/gpt-oss-120b",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "GEMINI_MODEL": "gemini-2.5-pro",
    "CEREBRAS_MODEL": "gpt-oss-120b",
    "AI_STOICA_MAX_HISTORY": "120",
    "AI_STOICA_MAX_CONTEXT_CHARS": "600000",
    "AI_STOICA_MAX_OUTPUT": "8192",
    "AI_STOICA_TEMPERATURE": "0.35",
    "GITHUB_REPO": "andrei18stoica-eng/Ai-Stoica",
    "GITHUB_BRANCH": "main",
    "AI_STOICA_FILE_MAX_MB": "25",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "ai-stoica-files-2026-001"
    }
  ]
}
